# Copy to .env (or export manually) depending on the environment.

# CORS: comma-separated allowed origins, or "*" for any.
ALLOWED_ORIGINS=*

# HuggingFace cache for TRIBE v2 / Llama-3.2-3B weights.
HF_HOME=/workspace/hf_cache

# Directory where uploaded videos are temporarily stored.
UPLOAD_DIR=/workspace/uploads

# 1 = skip loading tribev2/torch, return fake results (local frontend
# development without a GPU). 0 or unset = use the real model.
MOCK_MODEL=0
